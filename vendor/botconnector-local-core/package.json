{
  "name": "botconnector-ai",
  "version": "0.5.0-beta1",
  "description": "BotConnector AI beta: discover, run, and chat with local AI models, with optional cloud routing and coding-tool integrations",
  "license": "MIT",
  "author": {
    "name": "BotConnector Local",
    "email": "botconnector-local@botconnector.id",
    "url": "https://botconnector.id/"
  },
  "maintainers": [
    {
      "name": "BotConnector Local",
      "email": "botconnector-local@botconnector.id",
      "url": "https://botconnector.id/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farijarifriyanto-debug/BotConnector.git"
  },
  "homepage": "https://botconnector.id/",
  "bugs": {
    "url": "https://github.com/farijarifriyanto-debug/BotConnector/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "ai",
    "local-ai",
    "llama.cpp",
    "gguf",
    "chat",
    "coding-agent",
    "mcp",
    "model-runner",
    "botconnector"
  ],
  "main": "desktop/main.cjs",
  "bin": {
    "botconnector": "bin/botconnector.mjs"
  },
  "files": [
    "bin/",
    "tui/",
    "registry/",
    "agent/",
    "runtime/",
    "webui/",
    "desktop/security.cjs",
    "scripts/doctor.mjs",
    "doctor.cjs",
    "sessions.cjs",
    "state.cjs",
    "projects.cjs",
    "dist/web/",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "web": "node scripts/dev-server.mjs",
    "desktop": "electron .",
    "doctor": "node scripts/doctor.mjs",
    "cli": "node bin/botconnector.mjs",
    "test": "node --test tests/*.test.cjs",
    "release:gate": "node scripts/release-gate.mjs",
    "prepublishOnly": "npm run release:gate",
    "test:integration": "node --test tests/integration.test.cjs",
    "acceptance": "node scripts/live-acceptance.mjs",
    "acceptance:native": "node scripts/native-routes-acceptance.mjs",
    "acceptance:embeddings": "node scripts/embeddings-acceptance.mjs",
    "acceptance:tools": "node scripts/tooluse-acceptance.mjs",
    "acceptance:vision": "node scripts/vision-acceptance.mjs",
    "acceptance:auth": "node scripts/api-auth-acceptance.mjs",
    "acceptance:mcp": "node scripts/mcp-acceptance.mjs",
    "acceptance:mcp:product": "node scripts/mcp-product-acceptance.mjs",
    "acceptance:sdk:ts": "node scripts/sdk-acceptance.mjs",
    "acceptance:sdk:py": "node scripts/python-sdk-acceptance.mjs",
    "acceptance:surface": "node scripts/surface-consistency-acceptance.mjs",
    "acceptance:native-agent": "node scripts/native-agent-acceptance.mjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/desktop.js && node --check desktop/security.cjs && node --check runtime/hf.cjs && node --check runtime/downloads.cjs && node --check runtime/runtime-manager.cjs && node --check runtime/runtime-manager.cjs && node --check runtime/llama.cjs && node --check runtime/tools.cjs && node --check runtime/ownership.cjs && node --check runtime/ollama.cjs && node --check runtime/platform-paths.cjs && node --check webui/dialogs.cjs && node --check webui/server.cjs && node --check webui/single-instance.cjs && node --check bin/botconnector.mjs && node --check state.cjs && node --check doctor.cjs && node --check sessions.cjs && node --check projects.cjs && node --check agent/context.cjs && node --check agent/permissions.cjs && node --check agent/tools.cjs && node --check agent/mutate.cjs && node --check agent/shell.cjs && node --check agent/local.cjs && node --check agent/loop.cjs && node --check tui/theme.cjs && node --check tui/layout.cjs && node --check tui/activity.cjs && node --check tui/views.cjs && node --check tui/model-source.cjs && node --check tui/first-run.cjs && node --check tui/app.cjs && node --check tui/attach.cjs && node --check registry/integrations.cjs && node --check scripts/build-web.mjs && node --check scripts/web-bridge.js",
    "build:web": "node scripts/build-web.mjs",
    "build:sea": "node scripts/build-web.mjs && node scripts/build-sea.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:win": "node scripts/build-web.mjs && node scripts/build-sea.mjs && electron-builder --win --dir",
    "dist:win": "node scripts/build-web.mjs && node scripts/build-sea.mjs && electron-builder --win"
  },
  "dependencies": {
    "pend": "^1.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.botconnector.ai-local-cloud",
    "productName": "BotConnector AI",
    "directories": { "output": "dist" },
    "files": ["desktop/**", "runtime/**", "bin/**", "assets/**", "registry/**", "sdk/**", "node_modules/pend/**", "node_modules/yauzl/**", "package.json"],
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "extraFiles": [{ "from": "dist-sea/botconnector.exe", "to": "botconnector.exe" }],
    "win": { "target": [{ "target": "dir", "arch": ["x64"] }, { "target": "nsis", "arch": ["x64"] }], "icon": "assets/botconnector.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "include": "scripts/installer-path.nsh" },
    "afterPack": "scripts/afterpack-fuses.mjs"
  }
}
