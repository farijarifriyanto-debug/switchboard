{
  "manifest_version": 3,
  "name": "Switchboard Browser Companion",
  "version": "0.4.0",
  "description": "Autonomous and user-controlled browser automation companion for Switchboard (Chrome & Edge)",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open Switchboard Companion"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "onboarding-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/bico-16.png",
    "48": "icons/bico-48.png",
    "128": "icons/bico-128.png"
  }
}
